# Replace api.example.edu with the approved domain before enabling this file.
# Do not expose port 18080 directly to the Internet.
#
# Optional early request shedding for the unauthenticated auth endpoints (the Java service also
# enforces per-account lockout and per-email/per-IP quotas; this only drops volume earlier).
# The zone must be declared in the http {} context, for example in /etc/nginx/nginx.conf:
#
#   http {
#       limit_req_zone $binary_remote_addr zone=auth_per_ip:10m rate=10r/m;
#   }
#
# Then uncomment the auth location below (start conservatively and tune after load testing):
#
#   location /api/v1/auth/ {
#       limit_req zone=auth_per_ip burst=20 nodelay;
#       limit_req_status 429;
#       proxy_pass http://127.0.0.1:18080;
#       proxy_http_version 1.1;
#       proxy_set_header Host $host;
#       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#       proxy_set_header X-Forwarded-Proto $scheme;
#   }
server {
    listen 80;
    server_name api.example.edu;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name api.example.edu;

    ssl_certificate /etc/letsencrypt/live/api.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.edu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # The API service accepts up to 2 MiB on POST /api/v1/bank/publish and 1 MiB on
    # POST /api/v1/sync/events; every other endpoint is capped at 64 KiB by the service.
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
