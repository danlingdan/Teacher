[Unit]
Description=SQLTeacher Cloud operations health check
After=network-online.target sqlteacher-cloud.service sqlteacher-qdrant.service sqlteacher-embedding.service
Wants=network-online.target
ConditionPathExists=/opt/sqlteacher/current/bin/check-cloud-operations.sh

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/qdrant/qdrant.env
ExecStart=/opt/sqlteacher/current/bin/check-cloud-operations.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/nginx.pid /var/log/nginx /var/lib/qdrant
UMask=0027
TimeoutStartSec=2min
