[Unit]
Description=SQLTeacher Cloud API
After=network-online.target sqlteacher-qdrant.service sqlteacher-embedding.service
Wants=network-online.target sqlteacher-qdrant.service sqlteacher-embedding.service

[Service]
Type=simple
User=sqlteacher
Group=sqlteacher
WorkingDirectory=/opt/sqlteacher
EnvironmentFile=/etc/sqlteacher/cloud.env
EnvironmentFile=-/etc/qdrant/qdrant.env
ExecStart=/opt/sqlteacher/current/bin/run-cloud.sh
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sqlteacher/data

[Install]
WantedBy=multi-user.target
