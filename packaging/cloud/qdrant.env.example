# Copy to /etc/qdrant/qdrant.env, generate a unique random key, and set mode 0640 root:qdrant.
QDRANT__SERVICE__API_KEY=replace-with-a-random-32-byte-minimum-secret
SQLTEACHER_QDRANT_URL=http://127.0.0.1:6333
SQLTEACHER_QDRANT_COLLECTION=sqlteacher_course_knowledge_v1
SQLTEACHER_QDRANT_VECTOR_SIZE=512
SQLTEACHER_QDRANT_API_KEY=use-the-same-secret-as-QDRANT__SERVICE__API_KEY
SQLTEACHER_EMBEDDING_URL=http://127.0.0.1:11434
SQLTEACHER_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SQLTEACHER_EMBEDDING_PROVIDER=fastembed
