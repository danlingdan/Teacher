{
  "contractVersion": "3.0-v1",
  "compatibility": {
    "policy": "additive-within-v1",
    "breakingChange": "requires-new-contract-version",
    "unknownResponseFields": "ignore",
    "unknownMethods": "reject"
  },
  "limits": {
    "maxRequestBytes": 1048576,
    "maxConcurrentRequests": 8,
    "requestTimeoutMillis": 30000
  },
  "methods": [
    "account.login",
    "account.logout",
    "ai.knowledge.ask",
    "benchmark.echo",
    "cloud.class.create",
    "cloud.sync",
    "cloud.workspace",
    "course.workspace",
    "data.connections",
    "data.schema",
    "editor.languages",
    "home.summary",
    "knowledge.article",
    "knowledge.import.execute",
    "knowledge.import.preview",
    "knowledge.sample",
    "knowledge.search",
    "migration.status",
    "practice.catalog",
    "practice.preview",
    "practice.run",
    "practice.start",
    "practice.submit",
    "runner.capabilities",
    "runner.run",
    "session.current",
    "settings.update",
    "settings.workspace",
    "sql.analyze",
    "sql.execute",
    "sql.result.page",
    "system.cancel",
    "system.health",
    "system.shutdown",
    "task.demo",
    "teaching.exercise.toggle",
    "teaching.workspace"
  ],
  "events": ["ai.delta", "import.progress", "progress", "runner.progress"],
  "errorCodes": [
    "BRIDGE_UNAVAILABLE",
    "BUSY",
    "CANCELLED",
    "CONTRACT_VERSION_UNSUPPORTED",
    "DESKTOP_HOST_REQUIRED",
    "DUPLICATE_REQUEST",
    "INVALID_JSON",
    "INVALID_METHOD_OR_PARAMS",
    "INVALID_REQUEST",
    "LOCAL_APP_FAILURE",
    "LOCAL_BRIDGE_FAILED",
    "METHOD_NOT_ALLOWED",
    "PAYLOAD_TOO_LARGE",
    "SERIALIZATION_FAILED",
    "SIDECAR_EXITED",
    "SIDECAR_RUNTIME_MISSING",
    "SIDECAR_START_FAILED",
    "SIDECAR_TIMEOUT",
    "SIDECAR_WRITE_FAILED"
  ]
}
