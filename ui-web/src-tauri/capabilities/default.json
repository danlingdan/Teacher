{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create"
  ]
}
