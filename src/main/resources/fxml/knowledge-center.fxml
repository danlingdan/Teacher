<?xml version="1.0" encoding="UTF-8"?>

<?import com.sqlteacher.desktop.component.PageHeader?>
<?import com.sqlteacher.desktop.component.WorkflowSteps?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.KnowledgeCenterController"
            styleClass="exercise-page, knowledge-center-page">
    <top>
        <VBox spacing="12" styleClass="knowledge-center-header">
            <padding><Insets top="18" right="24" bottom="14" left="24"/></padding>
            <PageHeader title="%knowledge-center.simpleTitle" description="%knowledge-center.simpleDescription">
                <actions>
                    <Button text="%knowledge-center.5" onAction="#onRefresh" styleClass="secondary-button"/>
                </actions>
            </PageHeader>

            <WorkflowSteps fx:id="workflowSteps" steps="%knowledge-center.steps" activeStep="1"/>

            <VBox spacing="8" styleClass="panel-card, knowledge-search-card">
                <Label text="%knowledge-center.askTitle" styleClass="card-title"/>
                <Label text="%knowledge-center.askHint" wrapText="true" styleClass="card-description"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="queryField" promptText="%knowledge-center.simpleQuery" HBox.hgrow="ALWAYS"/>
                    <Button text="%knowledge-center.simpleSearch" onAction="#onSearch" styleClass="primary-button"/>
                    <Button text="%knowledge-center.simpleExplain" onAction="#onExplain" styleClass="secondary-button"/>
                </HBox>
            </VBox>

            <TitledPane fx:id="advancedPane" text="%knowledge-center.advancedTitle"
                        expanded="false" animated="false" styleClass="knowledge-advanced-pane">
                <content>
                    <VBox spacing="12" styleClass="knowledge-advanced-content">
                        <Label text="%knowledge-center.filterTitle" styleClass="cloud-subsection-title"/>
                        <GridPane hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="30" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="20" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <children>
                                <Label text="%knowledge-center.courseLabel" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="model-status"/>
                                <Label text="%knowledge-center.sectionLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="model-status"/>
                                <Label text="%knowledge-center.pointsLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="model-status"/>
                                <Label text="%knowledge-center.objectiveLabel" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="model-status"/>
                                <TextField fx:id="courseField" promptText="%knowledge-center.courseAny"
                                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <TextField fx:id="sectionField" promptText="%knowledge-center.sectionAny"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <TextField fx:id="knowledgePointsField" promptText="%knowledge-center.pointsAny"
                                           GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                <TextField fx:id="objectiveField" promptText="%knowledge-center.objectiveAuto"
                                           GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                            </children>
                        </GridPane>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <CheckBox fx:id="includePrivateCheck" text="%knowledge-center.11" selected="true"/>
                            <Button text="%knowledge-center.14" onAction="#onWebSearch" styleClass="secondary-button"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="indexStatusLabel" text="%knowledge-center.3" styleClass="model-status"/>
                            <Button text="%knowledge-center.4" onAction="#onRebuildIndex" styleClass="secondary-button"/>
                        </HBox>

                        <VBox fx:id="authoringPane" spacing="8" styleClass="knowledge-authoring-pane">
                            <Separator/>
                            <Label text="%knowledge-center.manageTitle" styleClass="cloud-subsection-title"/>
                            <Label text="%knowledge-center.manageHint" wrapText="true" styleClass="card-description"/>
                            <FlowPane hgap="8" vgap="8">
                                <children>
                                    <Button fx:id="importButton" text="%knowledge-center.6" onAction="#onImport" styleClass="primary-button"/>
                                    <Button fx:id="reviseButton" text="%knowledge-center.17" onAction="#onRevise" styleClass="secondary-button"/>
                                    <Button fx:id="publishButton" text="%knowledge-center.18" onAction="#onPublish" styleClass="secondary-button"/>
                                    <Button fx:id="privateButton" text="%knowledge-center.19" onAction="#onMakePrivate" styleClass="secondary-button"/>
                                    <Button fx:id="inactivateButton" text="%knowledge-center.20" onAction="#onInactivate" styleClass="secondary-button"/>
                                    <Button fx:id="deleteButton" text="%knowledge-center.21" onAction="#onDelete" styleClass="danger-outline-button"/>
                                </children>
                            </FlowPane>
                        </VBox>
                    </VBox>
                </content>
            </TitledPane>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.34" styleClass="knowledge-main-split">
            <items>
                <VBox spacing="10" styleClass="panel-card, knowledge-library-pane">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="%knowledge-center.libraryTitle" styleClass="card-title"/>
                            <Label text="%knowledge-center.libraryHint" wrapText="true" styleClass="model-status"/>
                        </VBox>
                    </HBox>
                    <TableView fx:id="articleTable" styleClass="result-table" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="%knowledge-center.libraryEmpty" wrapText="true" styleClass="model-status"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="articleTitleColumn" text="%knowledge-center.22" prefWidth="220"/>
                            <TableColumn fx:id="courseColumn" text="%knowledge-center.23" prefWidth="120"/>
                            <TableColumn fx:id="sectionColumn" text="%knowledge-center.24" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10" styleClass="panel-card, knowledge-detail-pane">
                    <VBox spacing="3">
                        <Label fx:id="detailTitleLabel" text="%knowledge-center.detailEmptyTitle" wrapText="true" styleClass="card-title"/>
                        <Label fx:id="detailMetaLabel" text="%knowledge-center.detailEmptyHint" wrapText="true" styleClass="model-status"/>
                    </VBox>
                    <TabPane fx:id="detailTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                        <tabs>
                            <Tab fx:id="contentTab" text="%knowledge-center.contentTab">
                                <VBox spacing="8">
                                    <TextArea fx:id="contentArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                                              promptText="%knowledge-center.32" styleClass="reading-content"/>
                                    <Button text="%knowledge-center.33" onAction="#onMarkRead" styleClass="secondary-button"/>
                                </VBox>
                            </Tab>
                            <Tab fx:id="resultTab" text="%knowledge-center.27">
                                <TableView fx:id="resultTable" styleClass="result-table">
                                    <placeholder>
                                        <Label text="%knowledge-center.resultEmpty" wrapText="true" styleClass="model-status"/>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="resultTitleColumn" text="%knowledge-center.28" prefWidth="180"/>
                                        <TableColumn fx:id="resultSourceColumn" text="%knowledge-center.29" prefWidth="140"/>
                                        <TableColumn fx:id="resultSnippetColumn" text="%knowledge-center.30" prefWidth="520"/>
                                    </columns>
                                </TableView>
                            </Tab>
                            <Tab fx:id="exerciseTab" text="%knowledge-center.34">
                                <VBox spacing="8">
                                    <TableView fx:id="exerciseTable" VBox.vgrow="ALWAYS">
                                        <placeholder>
                                            <Label text="%knowledge-center.exerciseEmpty" wrapText="true" styleClass="model-status"/>
                                        </placeholder>
                                        <columns>
                                            <TableColumn fx:id="exerciseTitleColumn" text="%knowledge-center.35" prefWidth="340"/>
                                            <TableColumn fx:id="exercisePointColumn" text="%knowledge-center.36" prefWidth="260"/>
                                        </columns>
                                    </TableView>
                                    <Button text="%knowledge-center.37" onAction="#onOpenExercise" styleClass="primary-button"/>
                                </VBox>
                            </Tab>
                            <Tab fx:id="answerTab" text="%knowledge-center.38">
                                <VBox spacing="8">
                                    <TextArea fx:id="answerArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                                              promptText="%knowledge-center.39"/>
                                    <HBox spacing="8" alignment="CENTER_RIGHT">
                                        <Label text="%knowledge-center.40" styleClass="model-status"/>
                                        <Button text="%knowledge-center.41" onAction="#onTutorHelpful" styleClass="secondary-button"/>
                                        <Button text="%knowledge-center.42" onAction="#onTutorStillConfused" styleClass="secondary-button"/>
                                        <Button text="%knowledge-center.43" onAction="#onTutorCitationError" styleClass="secondary-button"/>
                                    </HBox>
                                </VBox>
                            </Tab>
                        </tabs>
                    </TabPane>
                </VBox>
            </items>
            <BorderPane.margin><Insets top="0" right="24" bottom="12" left="24"/></BorderPane.margin>
        </SplitPane>
    </center>

    <bottom>
        <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true">
            <BorderPane.margin><Insets top="4" right="24" bottom="12" left="24"/></BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
