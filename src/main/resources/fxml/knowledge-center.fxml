<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.KnowledgeCenterController"
            styleClass="exercise-page">
    <top>
        <VBox spacing="10" styleClass="title-area">
            <padding><Insets top="16" right="20" bottom="10" left="20"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox spacing="4">
                    <Label text="%knowledge-center.1" styleClass="page-title"/>
                    <Label text="%knowledge-center.2" styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="indexStatusLabel" text="%knowledge-center.3" styleClass="page-subtitle"/>
                <Button text="%knowledge-center.4" onAction="#onRebuildIndex" styleClass="secondary-button"/>
                <Button text="%knowledge-center.5" onAction="#onRefresh" styleClass="secondary-button"/>
                <Button fx:id="importButton" text="%knowledge-center.6" onAction="#onImport" styleClass="refresh-button"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="courseField" promptText="%knowledge-center.7" prefWidth="180"/>
                <TextField fx:id="sectionField" promptText="%knowledge-center.8" prefWidth="180"/>
                <TextField fx:id="knowledgePointsField" promptText="%knowledge-center.9" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="objectiveField" promptText="%knowledge-center.10" prefWidth="210"/>
                <CheckBox fx:id="includePrivateCheck" text="%knowledge-center.11" selected="true"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="queryField" promptText="%knowledge-center.12" HBox.hgrow="ALWAYS"/>
                <Button text="%knowledge-center.13" onAction="#onSearch" styleClass="secondary-button"/>
                <Button text="%knowledge-center.14" onAction="#onWebSearch" styleClass="secondary-button"/>
                <Button text="%knowledge-center.15" onAction="#onExplain" styleClass="primary-button"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.43">
            <items>
                <VBox spacing="8" styleClass="progress-content">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="%knowledge-center.16" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="reviseButton" text="%knowledge-center.17" onAction="#onRevise" styleClass="secondary-button"/>
                        <Button fx:id="publishButton" text="%knowledge-center.18" onAction="#onPublish" styleClass="primary-button"/>
                        <Button fx:id="privateButton" text="%knowledge-center.19" onAction="#onMakePrivate" styleClass="secondary-button"/>
                        <Button fx:id="inactivateButton" text="%knowledge-center.20" onAction="#onInactivate" styleClass="secondary-button"/>
                        <Button fx:id="deleteButton" text="%knowledge-center.21" onAction="#onDelete" styleClass="danger-outline-button"/>
                    </HBox>
                    <TableView fx:id="articleTable" styleClass="result-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="articleTitleColumn" text="%knowledge-center.22" prefWidth="170"/>
                            <TableColumn fx:id="courseColumn" text="%knowledge-center.23" prefWidth="100"/>
                            <TableColumn fx:id="sectionColumn" text="%knowledge-center.24" prefWidth="100"/>
                            <TableColumn fx:id="visibilityColumn" text="%knowledge-center.25" prefWidth="70"/>
                            <TableColumn fx:id="revisionColumn" text="%knowledge-center.26" prefWidth="55"/>
                        </columns>
                    </TableView>
                </VBox>
                <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="progress-content">
                    <tabs>
                        <Tab text="%knowledge-center.27">
                            <TableView fx:id="resultTable" styleClass="result-table">
                                <columns>
                                    <TableColumn fx:id="resultTitleColumn" text="%knowledge-center.28" prefWidth="150"/>
                                    <TableColumn fx:id="resultSourceColumn" text="%knowledge-center.29" prefWidth="105"/>
                                    <TableColumn fx:id="resultSnippetColumn" text="%knowledge-center.30" prefWidth="420"/>
                                </columns>
                            </TableView>
                        </Tab>
                        <Tab text="%knowledge-center.31">
                            <VBox spacing="8">
                                <TextArea fx:id="contentArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" promptText="%knowledge-center.32"/>
                                <Button text="%knowledge-center.33" onAction="#onMarkRead" styleClass="secondary-button"/>
                            </VBox>
                        </Tab>
                        <Tab text="%knowledge-center.34">
                            <VBox spacing="8">
                                <TableView fx:id="exerciseTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="exerciseTitleColumn" text="%knowledge-center.35" prefWidth="300"/>
                                        <TableColumn fx:id="exercisePointColumn" text="%knowledge-center.36" prefWidth="220"/>
                                    </columns>
                                </TableView>
                                <Button text="%knowledge-center.37" onAction="#onOpenExercise" styleClass="primary-button"/>
                            </VBox>
                        </Tab>
                        <Tab text="%knowledge-center.38">
                            <VBox spacing="8">
                                <TextArea fx:id="answerArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" promptText="%knowledge-center.39"/>
                                <HBox spacing="8" alignment="CENTER_RIGHT">
                                    <Label text="%knowledge-center.40" styleClass="page-subtitle"/>
                                    <Button text="%knowledge-center.41" onAction="#onTutorHelpful" styleClass="secondary-button"/>
                                    <Button text="%knowledge-center.42" onAction="#onTutorStillConfused" styleClass="secondary-button"/>
                                    <Button text="%knowledge-center.43" onAction="#onTutorCitationError" styleClass="secondary-button"/>
                                </HBox>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true">
            <BorderPane.margin><Insets top="6" right="20" bottom="12" left="20"/></BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
