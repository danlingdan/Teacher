<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  v1.5.5 SQL workbench. The page no longer scrolls as one long document: examples remain
  above a resizable editor/result split so the primary action and execution feedback stay visible.
  Business fx:id values and controller actions remain unchanged.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.SqlPracticeController"
            styleClass="sql-practice-page">
    <top>
        <VBox styleClass="sql-practice-header" spacing="14">
            <VBox styleClass="title-area" alignment="CENTER" spacing="5">
                <Label styleClass="intro-tag" text="SAFE SQL WORKBENCH"/>
                <Label styleClass="page-title" text="%SqlPractice.1"/>
                <Label styleClass="page-subtitle"
                       text="%SqlPractice.2"/>
            </VBox>
            <VBox styleClass="panel-card examples-card" spacing="10">
                <HBox styleClass="card-title-row" alignment="CENTER_LEFT" spacing="10">
                    <Region styleClass="card-accent"/>
                    <Label styleClass="card-title" text="%SqlPractice.3"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="card-subtitle" text="%SqlPractice.4"/>
                </HBox>
                <FlowPane styleClass="example-flow" hgap="10" vgap="10">
                    <Button styleClass="example-chip" onAction="#onFillExampleSql"
                            text="SELECT id, name, score FROM student ORDER BY score DESC;"/>
                    <Button styleClass="example-chip" onAction="#onFillExampleSql"
                            text="SELECT * FROM student WHERE score &gt; 90;"/>
                    <Button styleClass="example-chip" onAction="#onFillExampleSql"
                            text="SELECT AVG(score) AS average_score FROM student;"/>
                    <Button styleClass="example-chip" onAction="#onFillExampleSql"
                            text="SELECT * FROM student WHERE score &gt; 999;"/>
                </FlowPane>
            </VBox>
        </VBox>
    </top>
    <center>
        <VBox styleClass="sql-practice-body">
            <SplitPane fx:id="workbenchSplit" orientation="VERTICAL" dividerPositions="0.48"
                       styleClass="sql-workbench-split" VBox.vgrow="ALWAYS">
                <items>
                    <VBox styleClass="panel-card editor-card" spacing="12">
                        <HBox styleClass="card-title-row" alignment="CENTER_LEFT" spacing="10">
                            <Region styleClass="card-accent"/>
                            <Label styleClass="card-title" text="%SqlPractice.5"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label styleClass="card-subtitle" text="%SqlPractice.6"/>
                        </HBox>
                        <TextArea fx:id="sqlInputArea" styleClass="sql-editor"
                                  promptText="%SqlPractice.7"
                                  wrapText="true" prefRowCount="7" VBox.vgrow="ALWAYS"/>
                        <HBox styleClass="sql-action-row" alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="clearSqlBtn" styleClass="sql-secondary-button"
                                    text="%SqlPractice.8" onAction="#onClearSql"/>
                            <Button fx:id="executeSqlButton" styleClass="sql-execute-button"
                                    text="%SqlPractice.9" onAction="#onExecuteSql"/>
                        </HBox>
                    </VBox>
                    <VBox styleClass="panel-card result-card" spacing="12">
                        <HBox styleClass="card-title-row" alignment="CENTER_LEFT" spacing="10">
                            <Region styleClass="card-accent"/>
                            <Label styleClass="card-title" text="%SqlPractice.10"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="resultStatusLabel" styleClass="sql-result-hint"
                                   visible="false" managed="false"/>
                        </HBox>
                        <StackPane fx:id="resultPane" styleClass="result-pane"
                                   minHeight="120" VBox.vgrow="ALWAYS">
                            <TableView fx:id="resultTable" styleClass="result-table"/>
                            <Label fx:id="emptyPlaceholder" styleClass="table-empty-hint"
                                   text="%SqlPractice.11"/>
                        </StackPane>
                        <Label fx:id="errorLabel" styleClass="sql-error-hint" wrapText="true"
                               maxWidth="Infinity" visible="false" managed="false"/>
                    </VBox>
                </items>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>
