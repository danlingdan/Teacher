<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.ConnectionSettingsController"
            styleClass="connection-settings-page">
    <top>
        <VBox spacing="6.0" styleClass="title-area">
            <padding><Insets top="20" right="24" bottom="14" left="24"/></padding>
            <Label text="%connection-settings.1" styleClass="page-title"/>
            <Label text="%connection-settings.2" styleClass="page-subtitle"/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.34" styleClass="connection-split">
            <VBox spacing="10" styleClass="panel-card">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="%connection-settings.3" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="%connection-settings.4" onAction="#onRefresh" styleClass="refresh-button"/>
                    <Button text="%connection-settings.5" onAction="#onNew" styleClass="refresh-button"/>
                </HBox>
                <ListView fx:id="profileList" VBox.vgrow="ALWAYS" styleClass="connection-list"/>
                <Label fx:id="currentLabel" text="%connection-settings.6" styleClass="model-status"/>
            </VBox>
            <ScrollPane fitToWidth="true" styleClass="connection-form-scroll">
                <VBox spacing="12" styleClass="panel-card, connection-form">
                    <Label text="%connection-settings.7" styleClass="card-title"/>
                    <GridPane hgap="12" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="92" halignment="RIGHT"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="220"/>
                        </columnConstraints>
                        <Label text="%connection-settings.8" GridPane.rowIndex="0" styleClass="form-label"/>
                        <TextField fx:id="idField" promptText="%connection-settings.9" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="%connection-settings.10" GridPane.rowIndex="1" styleClass="form-label"/>
                        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="%connection-settings.11" GridPane.rowIndex="2" styleClass="form-label"/>
                        <ComboBox fx:id="dialectBox" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>
                        <Label text="%connection-settings.12" GridPane.rowIndex="3" styleClass="form-label"/>
                        <TextField fx:id="pathField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="%connection-settings.13" GridPane.rowIndex="4" styleClass="form-label"/>
                        <TextField fx:id="hostField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <Label text="%connection-settings.14" GridPane.rowIndex="5" styleClass="form-label"/>
                        <TextField fx:id="portField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        <Label text="%connection-settings.15" GridPane.rowIndex="6" styleClass="form-label"/>
                        <TextField fx:id="databaseField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                        <Label text="%connection-settings.16" GridPane.rowIndex="7" styleClass="form-label"/>
                        <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                        <Label text="%connection-settings.17" GridPane.rowIndex="8" styleClass="form-label"/>
                        <PasswordField fx:id="passwordField" promptText="%connection-settings.18" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                    </GridPane>
                    <HBox spacing="18">
                        <CheckBox fx:id="readOnlyCheck" text="%connection-settings.19" selected="true"/>
                        <CheckBox fx:id="enabledCheck" text="%connection-settings.20" selected="true"/>
                    </HBox>
                    <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true" styleClass="sql-result-hint"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button fx:id="deleteButton" text="%connection-settings.21" onAction="#onDelete" styleClass="danger-button"/>
                        <Button fx:id="selectButton" text="%connection-settings.22" onAction="#onSelect" styleClass="refresh-button"/>
                        <Button fx:id="testButton" text="%connection-settings.23" onAction="#onTest" styleClass="refresh-button"/>
                        <Button fx:id="saveButton" text="%connection-settings.24" onAction="#onSave" styleClass="sql-execute-button"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>
