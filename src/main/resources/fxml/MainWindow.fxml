<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="mainWindowRoot" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.sqlteacher.desktop.controller.MainWindowController"
           styleClass="main-window">
    <BorderPane fx:id="mainContainer" minWidth="800" minHeight="560">
        <left>
            <VBox fx:id="appSidebar" styleClass="app-sidebar" minWidth="224" prefWidth="224" maxWidth="224" spacing="12">
                <padding><Insets top="18" right="14" bottom="16" left="14"/></padding>
                <VBox spacing="2" styleClass="sidebar-brand">
                    <Label fx:id="brandTitle" text="SQLTeacher" styleClass="brand-title"/>
                    <Label fx:id="sidebarCaption" text="%MainWindow.1" styleClass="sidebar-caption"/>
                </VBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="14">
                            <VBox fx:id="learningNavGroup" spacing="4" styleClass="nav-group">
                                <Label fx:id="learningNavGroupTitle" text="%MainWindow.2" styleClass="nav-group-title"/>
                                <Button fx:id="homeNavButton" text="%MainWindow.3" onAction="#onNavigateHome" maxWidth="Infinity" styleClass="nav-button"/>
                                <Button fx:id="studentExerciseNavButton" text="%MainWindow.4" onAction="#onNavigateStudentExercise" maxWidth="Infinity" styleClass="nav-button"/>
                            </VBox>
                            <VBox fx:id="courseNavGroup" spacing="4" styleClass="nav-group">
                                <Label fx:id="courseNavGroupTitle" text="%alpha2.nav.course" styleClass="nav-group-title"/>
                                <Button fx:id="databaseLearningNavButton" text="%v21.nav.databaseLearning" onAction="#onNavigateDatabaseLearning" maxWidth="Infinity" styleClass="nav-button"/>
                                <Button fx:id="courseMapNavButton" text="%alpha2.nav.courseMap" onAction="#onNavigateCourseMap" maxWidth="Infinity" styleClass="nav-button"/>
                                <Button fx:id="knowledgeCenterNavButton" text="%MainWindow.5" onAction="#onNavigateKnowledgeCenter" maxWidth="Infinity" styleClass="nav-button"/>
                            </VBox>
                            <VBox fx:id="toolsNavGroup" spacing="4" styleClass="nav-group">
                                <Label fx:id="toolsNavGroupTitle" text="%alpha2.nav.experiment" styleClass="nav-group-title"/>
                                <Button fx:id="sqlPracticeNavButton" text="%alpha2.nav.workspace" onAction="#onNavigateSqlPractice" maxWidth="Infinity" styleClass="nav-button"/>
                                <Button fx:id="aiAssistantNavButton" text="%MainWindow.13" onAction="#onNavigateAiAssistant" maxWidth="Infinity" styleClass="nav-button"/>
                                <Button fx:id="tableSchemaNavButton" text="%MainWindow.14" onAction="#onNavigateTableSchema" maxWidth="Infinity" styleClass="nav-button"/>
                            </VBox>
                            <VBox fx:id="teachingNavGroup" spacing="4" styleClass="nav-group">
                                <Label fx:id="teachingNavGroupTitle" text="%MainWindow.6" styleClass="nav-group-title"/>
                                <Button fx:id="teachingContentNavButton" text="%MainWindow.7" onAction="#onNavigateTeachingContent" maxWidth="Infinity" styleClass="nav-button"/>
                                <Button fx:id="exerciseManagementNavButton" text="%MainWindow.8" onAction="#onNavigateExerciseManagement" maxWidth="Infinity" styleClass="nav-button"/>
                                <Button fx:id="exerciseProgressNavButton" text="%MainWindow.9" onAction="#onNavigateExerciseProgress" maxWidth="Infinity" styleClass="nav-button"/>
                                <Button fx:id="cloudCenterNavButton" text="%MainWindow.10" onAction="#onNavigateCloudCenter" maxWidth="Infinity" styleClass="nav-button"/>
                            </VBox>
                            <VBox fx:id="systemNavGroup" spacing="4" styleClass="nav-group">
                                <Label fx:id="systemNavGroupTitle" text="%MainWindow.15" styleClass="nav-group-title"/>
                                <Button fx:id="settingsNavButton" text="%MainWindow.16" onAction="#onNavigateSettings" maxWidth="Infinity" styleClass="nav-button"/>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
                <VBox fx:id="identityCard" spacing="8" styleClass="identity-card">
                    <Label fx:id="identityLabel" text="%MainWindow.17" styleClass="identity-pill" wrapText="true"/>
                    <Button fx:id="switchIdentityButton" text="%MainWindow.18" onAction="#onSwitchIdentity"
                            maxWidth="Infinity" styleClass="identity-switch-button"/>
                </VBox>
            </VBox>
        </left>
        <center>
            <VBox styleClass="content-shell">
                <HBox alignment="CENTER_LEFT" spacing="12" minHeight="62" prefHeight="62" maxHeight="62"
                      styleClass="context-bar">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="contextTitle" text="%alpha2.nav.taskCenter" styleClass="context-title"/>
                        <Label fx:id="contextSubtitle" text="%alpha2.context.home" styleClass="context-subtitle"/>
                    </VBox>
                    <Button text="%alpha2.commandHint" onAction="#onCommandPalette"
                            mnemonicParsing="false" styleClass="keyboard-hint command-palette-button"/>
                </HBox>
                <StackPane fx:id="pageContainer" minHeight="0" styleClass="page-container" VBox.vgrow="ALWAYS"/>
            </VBox>
        </center>
    </BorderPane>

    <StackPane fx:id="loadingOverlay" styleClass="loading-overlay" visible="false" managed="false">
        <VBox alignment="CENTER" spacing="14">
            <ProgressIndicator styleClass="loading-spinner"/>
            <Label fx:id="loadingText" styleClass="loading-text" text="%MainWindow.19"/>
        </VBox>
    </StackPane>
</StackPane>
