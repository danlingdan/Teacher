<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.HomeController"
            styleClass="home-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
    <content>
<VBox styleClass="home-page" alignment="TOP_CENTER" spacing="24"
      maxWidth="Infinity" maxHeight="Infinity">
    <VBox styleClass="intro-section" alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS">
        <VBox.margin><Insets top="32" right="32" bottom="16" left="32"/></VBox.margin>
        <Label styleClass="intro-tag" text="AI + Database Education"/>
        <Label styleClass="intro-title" text="SQLTeacher"/>
        <Label styleClass="intro-description"
               text="%home.1"/>
        <Region styleClass="intro-divider"/>
    </VBox>

    <VBox styleClass="learning-queue-panel" spacing="10" maxWidth="910" fillWidth="true">
        <VBox.margin><Insets right="32" left="32"/></VBox.margin>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="%home.2"/>
                <Label fx:id="diagnosisSummaryLabel" styleClass="model-status" text="%home.3"/>
            </VBox>
            <Button text="%home.4" onAction="#onRefreshDiagnosis" styleClass="secondary-button"/>
        </HBox>
        <ListView fx:id="learningQueue" prefHeight="150" minHeight="120" styleClass="learning-queue-list"/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="queueStatusLabel" wrapText="true" styleClass="model-status" HBox.hgrow="ALWAYS"/>
            <Button fx:id="dismissActionButton" text="%home.5" onAction="#onDismissAction"
                    disable="true" styleClass="secondary-button"/>
            <Button fx:id="continueLearningButton" text="%home.6" onAction="#onContinueLearning"
                    disable="true" styleClass="primary-button"/>
        </HBox>
    </VBox>

    <TilePane styleClass="cards-container" alignment="CENTER" hgap="20" vgap="20"
              prefColumns="3" prefTileWidth="270" prefTileHeight="260" VBox.vgrow="ALWAYS">
        <VBox.margin><Insets right="32" bottom="32" left="32"/></VBox.margin>

        <Button onAction="#onSqlPracticeCardClick" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" maxWidth="Infinity"
                accessibleText="%home.7" styleClass="home-card">
            <graphic>
                <VBox alignment="TOP_LEFT" spacing="12" maxWidth="Infinity">
                    <Label fx:id="sqlIcon" styleClass="card-icon" accessibleText="%home.8"/>
                    <Label styleClass="card-title" text="%home.9"/>
                    <Label styleClass="card-description" wrapText="true"
                           text="%home.10"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="card-arrow" text="%home.11"/>
                </VBox>
            </graphic>
        </Button>

        <Button onAction="#onAiAssistantCardClick" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" maxWidth="Infinity"
                accessibleText="%home.12" styleClass="home-card">
            <graphic>
                <VBox alignment="TOP_LEFT" spacing="12" maxWidth="Infinity">
                    <Label fx:id="aiIcon" styleClass="card-icon" accessibleText="%home.13"/>
                    <Label styleClass="card-title" text="%home.14"/>
                    <Label styleClass="card-description" wrapText="true"
                           text="%home.15"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="card-arrow" text="%home.16"/>
                </VBox>
            </graphic>
        </Button>

        <Button onAction="#onTableSchemaCardClick" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" maxWidth="Infinity"
                accessibleText="%home.17" styleClass="home-card">
            <graphic>
                <VBox alignment="TOP_LEFT" spacing="12" maxWidth="Infinity">
                    <Label fx:id="schemaIcon" styleClass="card-icon" accessibleText="%home.18"/>
                    <Label styleClass="card-title" text="%home.19"/>
                    <Label styleClass="card-description" wrapText="true"
                           text="%home.20"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="card-arrow" text="%home.21"/>
                </VBox>
            </graphic>
        </Button>
    </TilePane>
</VBox>
    </content>
</ScrollPane>
