<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.HomeController"
            styleClass="home-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
    <content>
<VBox styleClass="home-page" alignment="TOP_CENTER" spacing="24"
      maxWidth="Infinity" maxHeight="Infinity">
    <VBox styleClass="intro-section" alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS">
        <VBox.margin><Insets top="32" right="32" bottom="16" left="32"/></VBox.margin>
        <Label styleClass="intro-tag" text="AI + Database Education"/>
        <Label styleClass="intro-title" text="SQLTeacher"/>
        <Label styleClass="intro-description"
               text="面向数据库教学的本地实训平台。选择下方任务开始练习；AI 输出仅作草案，所有 SQL 执行均经过 Java 侧安全检查。"/>
        <Region styleClass="intro-divider"/>
    </VBox>

    <VBox styleClass="learning-queue-panel" spacing="10" maxWidth="910" fillWidth="true">
        <VBox.margin><Insets right="32" left="32"/></VBox.margin>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="下一步学习"/>
                <Label fx:id="diagnosisSummaryLabel" styleClass="model-status" text="正在读取本机练习记录…"/>
            </VBox>
            <Button text="刷新诊断" onAction="#onRefreshDiagnosis" styleClass="secondary-button"/>
        </HBox>
        <ListView fx:id="learningQueue" prefHeight="150" minHeight="120" styleClass="learning-queue-list"/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="queueStatusLabel" wrapText="true" styleClass="model-status" HBox.hgrow="ALWAYS"/>
            <Button fx:id="dismissActionButton" text="暂时忽略" onAction="#onDismissAction"
                    disable="true" styleClass="secondary-button"/>
            <Button fx:id="continueLearningButton" text="继续学习" onAction="#onContinueLearning"
                    disable="true" styleClass="primary-button"/>
        </HBox>
    </VBox>

    <TilePane styleClass="cards-container" alignment="CENTER" hgap="20" vgap="20"
              prefColumns="3" prefTileWidth="270" prefTileHeight="260" VBox.vgrow="ALWAYS">
        <VBox.margin><Insets right="32" bottom="32" left="32"/></VBox.margin>

        <Button onAction="#onSqlPracticeCardClick" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" maxWidth="Infinity"
                accessibleText="打开 SQL 练习" styleClass="home-card">
            <graphic>
                <VBox alignment="TOP_LEFT" spacing="12" maxWidth="Infinity">
                    <Label fx:id="sqlIcon" styleClass="card-icon" accessibleText="SQL 练习"/>
                    <Label styleClass="card-title" text="SQL 练习"/>
                    <Label styleClass="card-description" wrapText="true"
                           text="编写并执行 SQL，查看查询结果和教学提示；高风险语句执行前需要明确确认。"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="card-arrow" text="打开 →"/>
                </VBox>
            </graphic>
        </Button>

        <Button onAction="#onAiAssistantCardClick" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" maxWidth="Infinity"
                accessibleText="打开 AI 助手" styleClass="home-card">
            <graphic>
                <VBox alignment="TOP_LEFT" spacing="12" maxWidth="Infinity">
                    <Label fx:id="aiIcon" styleClass="card-icon" accessibleText="AI 助手"/>
                    <Label styleClass="card-title" text="AI 助手"/>
                    <Label styleClass="card-description" wrapText="true"
                           text="根据自然语言生成 SQL 草案和解释，经过安全检查后复制到 SQL 练习页。"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="card-arrow" text="打开 →"/>
                </VBox>
            </graphic>
        </Button>

        <Button onAction="#onTableSchemaCardClick" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" maxWidth="Infinity"
                accessibleText="打开表结构浏览" styleClass="home-card">
            <graphic>
                <VBox alignment="TOP_LEFT" spacing="12" maxWidth="Infinity">
                    <Label fx:id="schemaIcon" styleClass="card-icon" accessibleText="表结构浏览"/>
                    <Label styleClass="card-title" text="表结构浏览"/>
                    <Label styleClass="card-description" wrapText="true"
                           text="以树形结构查看数据库表、字段类型和主键信息，并快速带入 SQL 编辑器。"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="card-arrow" text="打开 →"/>
                </VBox>
            </graphic>
        </Button>
    </TilePane>
</VBox>
    </content>
</ScrollPane>
