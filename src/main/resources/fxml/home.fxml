<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.sqlteacher.desktop.component.PageHeader?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.HomeController"
            styleClass="home-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
    <content>
<VBox styleClass="home-page home-dashboard" alignment="TOP_LEFT" spacing="20"
      maxWidth="Infinity" maxHeight="Infinity">
    <padding><Insets top="24" right="28" bottom="28" left="28"/></padding>
    <PageHeader fx:id="pageHeader" title="%home.22" description="%home.1"/>

    <VBox styleClass="learning-queue-panel" spacing="10" maxWidth="Infinity" fillWidth="true">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="%home.2"/>
                <Label fx:id="diagnosisSummaryLabel" styleClass="model-status" text="%home.3"/>
            </VBox>
            <Button fx:id="refreshDiagnosisButton" text="%home.4" onAction="#onRefreshDiagnosis"
                    styleClass="secondary-button"/>
        </HBox>
        <ListView fx:id="learningQueue" prefHeight="150" minHeight="120" styleClass="learning-queue-list">
            <placeholder>
                <Label fx:id="queueEmptyLabel" text="%home.3" wrapText="true" styleClass="model-status"/>
            </placeholder>
        </ListView>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="queueStatusLabel" wrapText="true" styleClass="model-status" HBox.hgrow="ALWAYS"/>
            <Button fx:id="dismissActionButton" text="%home.5" onAction="#onDismissAction"
                    disable="true" styleClass="secondary-button"/>
            <Button fx:id="continueLearningButton" text="%home.6" onAction="#onContinueLearning"
                    disable="true" styleClass="primary-button"/>
        </HBox>
    </VBox>

    <VBox spacing="4">
        <Label styleClass="section-title" text="%home.quickActions"/>
        <Label styleClass="model-status" text="%home.quickActionsDescription"/>
    </VBox>

    <GridPane styleClass="cards-container compact-action-grid" alignment="TOP_LEFT" hgap="14" vgap="14"
              prefWidth="534" maxWidth="534" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints minWidth="260" prefWidth="260" maxWidth="260"/>
            <ColumnConstraints minWidth="260" prefWidth="260" maxWidth="260"/>
        </columnConstraints>

        <Button onAction="#onSqlPracticeCardClick" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" minWidth="260" prefWidth="260" maxWidth="260"
                accessibleText="%home.7" styleClass="home-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <graphic>
                <VBox alignment="TOP_LEFT" spacing="8" prefWidth="228" maxWidth="228">
                    <Label fx:id="sqlIcon" styleClass="card-icon" accessibleText="%home.8"/>
                    <Label styleClass="card-title" text="%home.9"/>
                    <Label styleClass="card-description" wrapText="true"
                           text="%home.10"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="card-arrow" text="%home.11"/>
                </VBox>
            </graphic>
        </Button>

        <Button onAction="#onCourseMapCardClick" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" minWidth="260" prefWidth="260" maxWidth="260"
                accessibleText="%home.23" styleClass="home-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <graphic>
                <VBox alignment="TOP_LEFT" spacing="8" prefWidth="228" maxWidth="228">
                    <Label fx:id="courseIcon" styleClass="card-icon" accessibleText="%home.23"/>
                    <Label styleClass="card-title" text="%home.23"/>
                    <Label styleClass="card-description" wrapText="true" text="%home.24"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="card-arrow" text="%home.11"/>
                </VBox>
            </graphic>
        </Button>

        <Button onAction="#onAiAssistantCardClick" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" minWidth="260" prefWidth="260" maxWidth="260"
                accessibleText="%home.12" styleClass="home-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <graphic>
                <VBox alignment="TOP_LEFT" spacing="8" prefWidth="228" maxWidth="228">
                    <Label fx:id="aiIcon" styleClass="card-icon" accessibleText="%home.13"/>
                    <Label styleClass="card-title" text="%home.14"/>
                    <Label styleClass="card-description" wrapText="true"
                           text="%home.15"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="card-arrow" text="%home.16"/>
                </VBox>
            </graphic>
        </Button>

        <Button onAction="#onTableSchemaCardClick" contentDisplay="GRAPHIC_ONLY"
                mnemonicParsing="false" minWidth="260" prefWidth="260" maxWidth="260"
                accessibleText="%home.17" styleClass="home-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <graphic>
                <VBox alignment="TOP_LEFT" spacing="8" prefWidth="228" maxWidth="228">
                    <Label fx:id="schemaIcon" styleClass="card-icon" accessibleText="%home.18"/>
                    <Label styleClass="card-title" text="%home.19"/>
                    <Label styleClass="card-description" wrapText="true"
                           text="%home.20"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label styleClass="card-arrow" text="%home.21"/>
                </VBox>
            </graphic>
        </Button>
    </GridPane>
</VBox>
    </content>
</ScrollPane>
