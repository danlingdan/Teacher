<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.sqlteacher.desktop.component.PageHeader?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.StudentExerciseController"
            styleClass="exercise-page">
    <top>
        <VBox spacing="8" styleClass="student-workflow-header">
            <padding><Insets top="20" right="24" bottom="14" left="24"/></padding>
            <PageHeader title="%student-exercise.1" description="%student-exercise.2"/>
            <Label text="%student-exercise.3"
                   wrapText="true" styleClass="workflow-hint"/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.27" styleClass="exercise-split">
            <VBox spacing="10" styleClass="panel-card">
                <HBox alignment="CENTER_LEFT">
                    <Label text="%student-exercise.4" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="%student-exercise.5" onAction="#onRefresh" styleClass="refresh-button"/>
                </HBox>
                <ListView fx:id="exerciseList" VBox.vgrow="ALWAYS" styleClass="exercise-list"/>
                <Button fx:id="startButton" text="%student-exercise.6" disable="true" onAction="#onStart"
                        maxWidth="Infinity" styleClass="sql-execute-button"/>
            </VBox>
            <VBox spacing="10" styleClass="exercise-workspace">
                <VBox spacing="5" styleClass="panel-card">
                    <Label fx:id="titleLabel" text="%student-exercise.7" styleClass="card-title"/>
                    <Label fx:id="metaLabel" text="-" styleClass="model-status"/>
                    <Label fx:id="descriptionLabel" text="%student-exercise.8" wrapText="true" styleClass="card-description"/>
                    <Label fx:id="schemaLabel" text="%student-exercise.9" wrapText="true" styleClass="exercise-schema-summary"/>
                </VBox>
                <VBox spacing="8" styleClass="panel-card" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="%student-exercise.10" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="resetButton" text="%student-exercise.11" onAction="#onReset" styleClass="refresh-button"/>
                        <Button fx:id="hintButton" text="%student-exercise.12" onAction="#onHint" styleClass="refresh-button"/>
                        <Button fx:id="runButton" text="%student-exercise.13" onAction="#onRun" styleClass="secondary-button"/>
                        <Button fx:id="submitButton" text="%student-exercise.14" onAction="#onSubmit" defaultButton="true" styleClass="sql-execute-button"/>
                    </HBox>
                    <TextArea fx:id="sqlArea" prefRowCount="9" minHeight="180" prefHeight="220"
                              styleClass="sql-editor, exercise-sql-editor" VBox.vgrow="SOMETIMES"/>
                    <SplitPane orientation="VERTICAL" dividerPositions="0.62" VBox.vgrow="ALWAYS" styleClass="exercise-result-split">
                        <TableView fx:id="resultTable" styleClass="result-table"/>
                        <TextArea fx:id="feedbackArea" editable="false" wrapText="true" promptText="%student-exercise.15"/>
                    </SplitPane>
                    <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true"/>
                </VBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
