<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.CloudCenterController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="cloud-center-scroll">
    <content>
        <VBox spacing="16" styleClass="cloud-center-page">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="cloud-page-header">
                    <children>
                        <Region styleClass="cloud-title-badge"/>
                        <VBox spacing="3">
                            <children>
                                <Label text="云端教学" styleClass="page-title, cloud-page-title"/>
                                <Label text="管理教学班级、发布任务并安全同步学习记录" styleClass="page-subtitle, cloud-page-subtitle"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ProgressIndicator fx:id="busyIndicator"
                                           visible="false" managed="false"
                                           prefWidth="26" prefHeight="26"
                                           styleClass="cloud-busy-indicator"/>
                    </children>
                </HBox>

                <HBox fx:id="statusBanner" alignment="CENTER_LEFT" spacing="10" styleClass="cloud-status-banner, status-info">
                    <children>
                        <Region styleClass="cloud-status-dot"/>
                        <Label fx:id="statusLabel" text="请登录云端账号" wrapText="true" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="accountLabel" text="未登录" styleClass="cloud-account-pill"/>
                    </children>
                </HBox>

                <VBox spacing="12" styleClass="panel-card, cloud-section-card">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="card-title-row">
                            <children>
                                <Region styleClass="card-accent"/>
                                <Label text="云端账号" styleClass="card-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="访问令牌仅保留在当前程序内存" styleClass="cloud-helper-text"/>
                            </children>
                        </HBox>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <children>
                                <Label text="当前身份由启动登录页统一管理；退出后会立即返回身份选择界面。" wrapText="true" HBox.hgrow="ALWAYS" styleClass="cloud-helper-text"/>
                                <Button fx:id="logoutButton" text="退出并切换身份" onAction="#onLogout" styleClass="danger-outline-button"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox fx:id="signedOutPrompt" spacing="6" styleClass="panel-card, cloud-signed-out-prompt">
                    <children>
                        <Label text="登录后使用云端教学工作区" styleClass="card-title"/>
                        <Label text="请通过左下角“切换身份”登录云端账号；登录后将显示班级、任务、同步与管理操作。"
                               wrapText="true" styleClass="cloud-helper-text"/>
                    </children>
                </VBox>

                <VBox fx:id="authenticatedContent" spacing="16" disable="true" visible="false" managed="false"
                      styleClass="authenticated-content">
                    <children>
                        <GridPane hgap="16" vgap="16" prefHeight="470">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="36" hgrow="ALWAYS" minWidth="250"/>
                                <ColumnConstraints percentWidth="64" hgrow="ALWAYS" minWidth="390"/>
                            </columnConstraints>
                            <children>
                                <VBox spacing="12" styleClass="panel-card, cloud-section-card" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="card-title-row">
                                            <children>
                                                <Region styleClass="card-accent"/>
                                                <Label text="我的班级" styleClass="card-title"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Button text="刷新" onAction="#onRefresh" styleClass="compact-button, secondary-button"/>
                                            </children>
                                        </HBox>
                                        <Label fx:id="classSummaryLabel" text="登录后加载班级" wrapText="true" styleClass="cloud-helper-text"/>
                                        <FlowPane fx:id="classCreationPane" hgap="8" vgap="8" prefWrapLength="300">
                                            <children>
                                                <TextField fx:id="classNameField" promptText="新班级名称" prefWidth="190"/>
                                                <Button text="创建" onAction="#onCreateClass" styleClass="primary-button"/>
                                            </children>
                                        </FlowPane>
                                        <ListView fx:id="classList" VBox.vgrow="ALWAYS" minHeight="260" styleClass="cloud-list"/>
                                    </children>
                                </VBox>

                                <VBox spacing="14" styleClass="panel-card, cloud-section-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="card-title-row">
                                            <children>
                                                <Region styleClass="card-accent"/>
                                                <Label text="班级工作区" styleClass="card-title"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="selectedClassLabel" text="尚未选择班级" styleClass="cloud-selection-pill"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="classAnalyticsLabel" text="选择班级后查看教学记录" wrapText="true" HBox.hgrow="ALWAYS" styleClass="cloud-helper-text"/>
                                                <Button fx:id="exportClassRecordsButton" text="导出教学记录" onAction="#onExportClassRecords" styleClass="compact-button, secondary-button"/>
                                            </children>
                                        </HBox>

                                        <VBox fx:id="memberManagementPane" spacing="8" styleClass="cloud-subsection">
                                            <children>
                                                <Label text="添加成员" styleClass="cloud-subsection-title"/>
                                                <FlowPane fx:id="assignmentCreationPane" hgap="8" vgap="8" prefWrapLength="560">
                                                    <children>
                                                        <TextField fx:id="memberEmailField" promptText="成员邮箱" prefWidth="240"/>
                                                        <ComboBox fx:id="memberRoleCombo" prefWidth="125"/>
                                                        <Button text="添加成员" onAction="#onAddMember" styleClass="secondary-button"/>
                                                    </children>
                                                </FlowPane>
                                            </children>
                                        </VBox>

                                        <Separator/>

                                        <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="cloud-subsection">
                                            <children>
                                                <Label text="发布班级任务" styleClass="cloud-subsection-title"/>
                                                <FlowPane hgap="8" vgap="8" prefWrapLength="560">
                                                    <children>
                                                        <TextField fx:id="assignmentExerciseField" promptText="本地题目 ID" prefWidth="180"/>
                                                        <TextField fx:id="assignmentTitleField" promptText="任务标题" prefWidth="230"/>
                                                        <TextField fx:id="assignmentDescriptionField" promptText="任务说明（可选）" prefWidth="260"/>
                                                        <DatePicker fx:id="assignmentDueDatePicker" promptText="截止日期（可选）" prefWidth="170"/>
                                                        <ComboBox fx:id="assignmentDueTimeCombo" promptText="截止时间" prefWidth="110"/>
                                                        <Button text="发布任务" onAction="#onCreateAssignment" styleClass="primary-button"/>
                                                        <Button text="保存草稿" onAction="#onSaveAssignmentDraft" styleClass="secondary-button"/>
                                                    </children>
                                                </FlowPane>
                                                <HBox fx:id="assignmentLifecyclePane" spacing="8">
                                                    <children>
                                                        <Button text="截止所选任务" onAction="#onCloseAssignment" styleClass="compact-button, secondary-button"/>
                                                        <Button text="撤回所选任务" onAction="#onWithdrawAssignment" styleClass="compact-button, danger-outline-button"/>
                                                        <Button text="更新所选任务" onAction="#onUpdateAssignment" styleClass="compact-button, secondary-button"/>
                                                        <Button text="复制为草稿" onAction="#onCopyAssignment" styleClass="compact-button, secondary-button"/>
                                                        <Button text="归档所选任务" onAction="#onArchiveAssignment" styleClass="compact-button, secondary-button"/>
                                                    </children>
                                                </HBox>
                                                <HBox fx:id="studentAssignmentPane" spacing="8" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Button text="开始所选任务" onAction="#onOpenAssignment" styleClass="primary-button"/>
                                                        <Label text="将在本地隔离数据集完成确定性评测" styleClass="cloud-helper-text"/>
                                                    </children>
                                                </HBox>
                                                <ListView fx:id="assignmentList" VBox.vgrow="ALWAYS" minHeight="170" styleClass="cloud-list"/>
                                                <HBox spacing="8" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label fx:id="assignmentAnalyticsLabel" text="选择任务后可加载提交与通过统计" wrapText="true" HBox.hgrow="ALWAYS" styleClass="cloud-helper-text"/>
                                                        <Button text="刷新任务学情" onAction="#onRefreshAssignmentAnalytics" styleClass="compact-button, secondary-button"/>
                                                        <Button text="导出任务 CSV" onAction="#onExportAssignmentAnalytics" styleClass="compact-button, secondary-button"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="panel-card, cloud-sync-card">
                            <children>
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="学习记录同步" styleClass="card-title"/>
                                        <Label text="上传本机未同步事件，并下载此账号在其他设备产生的新记录" wrapText="true" styleClass="cloud-helper-text"/>
                                        <Label fx:id="submissionQueueLabel" text="登录后读取待同步任务" wrapText="true" styleClass="cloud-helper-text"/>
                                    </children>
                                </VBox>
                                <Button fx:id="syncButton" text="立即同步" onAction="#onSync" styleClass="primary-button, cloud-sync-button"/>
                            </children>
                        </HBox>

                        <VBox fx:id="adminOperationsPane" spacing="12" styleClass="panel-card, cloud-section-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <children>
                                        <Label text="管理员运维" styleClass="card-title"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="刷新健康、账号与审计" onAction="#onRefreshAdminOperations" styleClass="secondary-button"/>
                                    </children>
                                </HBox>
                                <Label fx:id="adminHealthLabel" text="点击刷新读取非敏感健康摘要" wrapText="true" styleClass="cloud-helper-text"/>
                                <SplitPane dividerPositions="0.5" prefHeight="240">
                                    <items>
                                        <VBox spacing="8">
                                            <children>
                                                <Label text="账号运维" styleClass="cloud-subsection-title"/>
                                                <ListView fx:id="adminUserList" VBox.vgrow="ALWAYS" styleClass="cloud-list"/>
                                                <FlowPane hgap="8" vgap="8">
                                                    <children>
                                                        <TextField fx:id="adminReasonField" promptText="原因码，如 SECURITY_RESET" prefWidth="230"/>
                                                        <Button text="禁用" onAction="#onDisableAdminUser" styleClass="danger-outline-button"/>
                                                        <Button text="恢复" onAction="#onRestoreAdminUser" styleClass="secondary-button"/>
                                                        <Button text="撤销会话" onAction="#onRevokeAdminUserSessions" styleClass="secondary-button"/>
                                                    </children>
                                                </FlowPane>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8">
                                            <children>
                                                <Label text="最近审计" styleClass="cloud-subsection-title"/>
                                                <ListView fx:id="adminAuditList" VBox.vgrow="ALWAYS" styleClass="cloud-list"/>
                                            </children>
                                        </VBox>
                                    </items>
                                </SplitPane>
                                <Separator/>
                                <Label text="数据保留与恢复" styleClass="cloud-subsection-title"/>
                                <FlowPane hgap="8" vgap="8">
                                    <children>
                                        <ComboBox fx:id="retentionCategoryCombo" prefWidth="210"/>
                                        <TextField fx:id="retentionCutoffField" promptText="截止时间 ISO-8601" prefWidth="230"/>
                                        <TextField fx:id="retentionBackupField" promptText="外部备份引用" prefWidth="210"/>
                                        <Button text="预览" onAction="#onPreviewRetention" styleClass="secondary-button"/>
                                        <Button text="确认清理" onAction="#onExecuteRetention" styleClass="danger-outline-button"/>
                                        <Button text="恢复最近作业" onAction="#onRestoreRetention" styleClass="secondary-button"/>
                                    </children>
                                </FlowPane>
                                <Label fx:id="retentionStatusLabel" text="必须先预览影响范围，执行前还会自动生成并校验安全快照" wrapText="true" styleClass="cloud-helper-text"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets top="22" right="24" bottom="28" left="24"/>
            </padding>
        </VBox>
    </content>
</ScrollPane>
