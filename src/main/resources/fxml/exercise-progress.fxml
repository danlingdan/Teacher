<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.sqlteacher.desktop.component.PageHeader?>
<?import com.sqlteacher.desktop.component.MetricCard?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.ExerciseProgressController"
            styleClass="exercise-page">
    <top>
        <VBox spacing="12" styleClass="title-area">
            <padding><Insets top="18" right="24" bottom="12" left="24"/></padding>
            <PageHeader title="%exercise-progress.1" description="%exercise-progress.2">
                <actions>
                    <Button text="%exercise-progress.3" onAction="#onResetLearningData" styleClass="danger-outline-button"/>
                    <Button fx:id="exportButton" text="%exercise-progress.4" onAction="#onExport" styleClass="secondary-button" disable="true"/>
                    <Button text="%exercise-progress.5" onAction="#onRefresh" styleClass="refresh-button"/>
                </actions>
            </PageHeader>
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="analytics-filter-bar">
                <Label text="%exercise-progress.6"/><DatePicker fx:id="startDatePicker" prefWidth="130"/>
                <Label text="%exercise-progress.7"/><DatePicker fx:id="endDatePicker" prefWidth="130"/>
                <ComboBox fx:id="exerciseFilter" promptText="%exercise-progress.8" prefWidth="170"/>
                <ComboBox fx:id="knowledgeFilter" promptText="%exercise-progress.9" prefWidth="135"/>
                <ComboBox fx:id="errorFilter" promptText="%exercise-progress.10" prefWidth="165"/>
                <Button text="%exercise-progress.11" onAction="#onRefresh" styleClass="secondary-button"/>
                <Button text="%exercise-progress.12" onAction="#onClearFilters" styleClass="secondary-button"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="10" styleClass="progress-content">
            <TilePane prefColumns="6" hgap="10" vgap="8">
                <MetricCard fx:id="sessionsLabel" label="%exercise-progress.13" value="0"/>
                <MetricCard fx:id="attemptsLabel" label="%exercise-progress.14" value="0"/>
                <MetricCard fx:id="passRateLabel" label="%exercise-progress.15" value="0%"/>
                <MetricCard fx:id="completionRateLabel" label="%exercise-progress.16" value="0%"/>
                <MetricCard fx:id="averageAttemptsLabel" label="%exercise-progress.17" value="0"/>
                <MetricCard fx:id="durationLabel" label="%exercise-progress.18" value="0 ms"/>
            </TilePane>
            <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <Tab text="%exercise-progress.19">
                        <TableView fx:id="exerciseTable" styleClass="result-table">
                            <columns>
                                <TableColumn fx:id="titleColumn" text="%exercise-progress.20" prefWidth="220"/>
                                <TableColumn fx:id="knowledgeColumn" text="%exercise-progress.21" prefWidth="130"/>
                                <TableColumn fx:id="attemptsColumn" text="%exercise-progress.22" prefWidth="70"/>
                                <TableColumn fx:id="submissionsColumn" text="%exercise-progress.23" prefWidth="70"/>
                                <TableColumn fx:id="passColumn" text="%exercise-progress.24" prefWidth="90"/>
                                <TableColumn fx:id="completedColumn" text="%exercise-progress.25" prefWidth="90"/>
                                <TableColumn fx:id="lastAttemptColumn" text="%exercise-progress.26" prefWidth="130"/>
                            </columns>
                        </TableView>
                    </Tab>
                    <Tab text="%exercise-progress.27">
                        <TableView fx:id="errorTable" styleClass="result-table">
                            <columns>
                                <TableColumn fx:id="errorCodeColumn" text="%exercise-progress.28" prefWidth="320"/>
                                <TableColumn fx:id="errorCountColumn" text="%exercise-progress.29" prefWidth="120"/>
                            </columns>
                        </TableView>
                    </Tab>
                    <Tab text="%exercise-progress.30">
                        <TableView fx:id="knowledgeTable" styleClass="result-table">
                            <columns>
                                <TableColumn fx:id="pointColumn" text="%exercise-progress.31" prefWidth="180"/>
                                <TableColumn fx:id="pointAttemptsColumn" text="%exercise-progress.32" prefWidth="90"/>
                                <TableColumn fx:id="pointFailuresColumn" text="%exercise-progress.33" prefWidth="110"/>
                                <TableColumn fx:id="pointCompletionColumn" text="%exercise-progress.34" prefWidth="110"/>
                                <TableColumn fx:id="weaknessColumn" text="%exercise-progress.35" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </Tab>
                    <Tab text="%exercise-progress.36">
                        <VBox spacing="8">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="%exercise-progress.37" styleClass="model-status"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="%exercise-progress.38" onAction="#onRefreshInterventions" styleClass="secondary-button"/>
                                <Button text="%exercise-progress.39" onAction="#onAcknowledgeIntervention" styleClass="secondary-button"/>
                                <Button text="%exercise-progress.40" onAction="#onResolveIntervention" styleClass="primary-button"/>
                                <Button text="%exercise-progress.41" onAction="#onDismissIntervention" styleClass="secondary-button"/>
                                <Button text="%exercise-progress.42" onAction="#onOpenTeachingWorkspace" styleClass="secondary-button"/>
                                <Button text="%exercise-progress.43" onAction="#onExportInterventions" styleClass="secondary-button"/>
                            </HBox>
                            <TableView fx:id="interventionTable" styleClass="result-table" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="interventionClassColumn" text="%exercise-progress.44" prefWidth="120"/>
                                    <TableColumn fx:id="interventionAssignmentColumn" text="%exercise-progress.45" prefWidth="170"/>
                                    <TableColumn fx:id="interventionStudentColumn" text="%exercise-progress.46" prefWidth="140"/>
                                    <TableColumn fx:id="interventionReasonColumn" text="%exercise-progress.47" prefWidth="110"/>
                                    <TableColumn fx:id="interventionEvidenceColumn" text="%exercise-progress.48" prefWidth="260"/>
                                    <TableColumn fx:id="interventionStatusColumn" text="%exercise-progress.49" prefWidth="100"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>
            <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
