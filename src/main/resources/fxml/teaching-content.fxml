<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.sqlteacher.desktop.component.PageHeader?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.TeachingContentController"
            styleClass="teaching-workbench">
    <top>
        <VBox spacing="8" styleClass="student-workflow-header">
            <PageHeader title="%teaching-content.1" description="%teaching-content.2">
                <actions>
                    <Button text="%teaching-content.3" onAction="#onRefresh" styleClass="secondary-button"/>
                </actions>
            </PageHeader>
            <Label fx:id="statusLabel" text="%teaching-content.4" wrapText="true" styleClass="status-info"/>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="workspaceTabs" tabClosingPolicy="UNAVAILABLE" styleClass="teaching-tabs">
            <tabs>
                <Tab fx:id="teacherTab" text="%teaching-content.5">
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
                        <content>
                            <VBox fx:id="teacherPane" spacing="14" styleClass="page-content">
                                <padding><Insets top="18" right="22" bottom="24" left="22"/></padding>
                                <VBox spacing="10" styleClass="panel-card">
                                    <Label text="%teaching-content.6" styleClass="section-title"/>
                                    <FlowPane hgap="10" vgap="10">
                                        <TextField fx:id="courseNameField" promptText="%teaching-content.7" prefWidth="220"/>
                                        <TextArea fx:id="courseDescriptionField" promptText="%teaching-content.8" prefWidth="340" prefRowCount="2" wrapText="true"/>
                                        <Button text="%teaching-content.9" onAction="#onCreateCourse" styleClass="primary-button"/>
                                        <Button text="%teaching-content.10" onAction="#onSaveCourse" styleClass="secondary-button"/>
                                        <Button text="%teaching-content.11" onAction="#onToggleCourseStatus" styleClass="secondary-button"/>
                                        <Button text="%teaching-content.12" onAction="#onImportCourse" styleClass="secondary-button"/>
                                        <Button text="%teaching-content.13" onAction="#onExportCourse" styleClass="secondary-button"/>
                                    </FlowPane>
                                    <ListView fx:id="courseList" prefHeight="112"/>
                                    <Separator/>
                                    <Label text="%teaching-content.14" styleClass="card-title"/>
                                    <FlowPane hgap="10" vgap="10">
                                        <TextField fx:id="sectionNameField" promptText="%teaching-content.15" prefWidth="220"/>
                                        <TextField fx:id="sectionOrderField" promptText="%teaching-content.16" prefWidth="90"/>
                                        <Button text="%teaching-content.17" onAction="#onCreateSection" styleClass="primary-button"/>
                                        <Button text="%teaching-content.18" onAction="#onUpdateSection" styleClass="secondary-button"/>
                                        <Button text="%teaching-content.19" onAction="#onToggleSectionStatus" styleClass="secondary-button"/>
                                    </FlowPane>
                                    <ListView fx:id="sectionList" prefHeight="96"/>
                                    <Label text="%teaching-content.20" styleClass="card-title"/>
                                    <FlowPane hgap="10" vgap="10">
                                        <TextField fx:id="knowledgePointNameField" promptText="%teaching-content.21" prefWidth="220"/>
                                        <TextField fx:id="knowledgePointOrderField" promptText="%teaching-content.22" prefWidth="90"/>
                                        <TextArea fx:id="knowledgePointDescriptionField" promptText="%teaching-content.23" prefWidth="340" prefRowCount="2" wrapText="true"/>
                                        <Button text="%teaching-content.24" onAction="#onCreateKnowledgePoint" styleClass="primary-button"/>
                                        <Button text="%teaching-content.25" onAction="#onUpdateKnowledgePoint" styleClass="secondary-button"/>
                                        <Button text="%teaching-content.26" onAction="#onToggleKnowledgePointStatus" styleClass="secondary-button"/>
                                    </FlowPane>
                                    <ListView fx:id="knowledgePointList" prefHeight="104"/>
                                </VBox>

                                <VBox spacing="10" styleClass="panel-card">
                                    <Label text="%teaching-content.27" styleClass="section-title"/>
                                    <Label text="%teaching-content.28"
                                           wrapText="true" styleClass="page-subtitle"/>
                                    <FlowPane hgap="10" vgap="10">
                                        <TextField fx:id="objectiveTitleField" promptText="%teaching-content.29" prefWidth="240"/>
                                        <TextField fx:id="objectiveCriteriaField" promptText="%teaching-content.30" prefWidth="330"/>
                                        <TextField fx:id="objectiveOrderField" promptText="%teaching-content.31" prefWidth="90"/>
                                    </FlowPane>
                                    <TextArea fx:id="objectiveDescriptionField" promptText="%teaching-content.32" prefRowCount="2" wrapText="true"/>
                                    <HBox spacing="10" alignment="CENTER_RIGHT">
                                        <Button text="%teaching-content.33" onAction="#onToggleObjectiveStatus" styleClass="secondary-button"/>
                                        <Button text="%teaching-content.34" onAction="#onSaveObjective" styleClass="secondary-button"/>
                                        <Button text="%teaching-content.35" onAction="#onCreateObjective" styleClass="primary-button"/>
                                    </HBox>
                                    <ListView fx:id="objectiveList" prefHeight="126"/>
                                    <FlowPane hgap="10" vgap="10">
                                        <ComboBox fx:id="prerequisiteObjectiveCombo" promptText="%teaching-content.36" prefWidth="240"/>
                                        <Button text="%teaching-content.37" onAction="#onAddObjectivePrerequisite" styleClass="secondary-button"/>
                                        <ComboBox fx:id="objectiveResourceTypeCombo" prefWidth="190"/>
                                        <TextField fx:id="objectiveResourceIdField" promptText="%teaching-content.38" prefWidth="300"/>
                                        <Button text="%teaching-content.39" onAction="#onBindObjectiveResource" styleClass="primary-button"/>
                                    </FlowPane>
                                </VBox>

                                <VBox spacing="10" styleClass="panel-card">
                                    <Label text="%teaching-content.40" styleClass="section-title"/>
                                    <Label text="%teaching-content.41" styleClass="page-subtitle"/>
                                    <FlowPane hgap="10" vgap="10">
                                        <TextField fx:id="localExerciseIdField" promptText="%teaching-content.42" prefWidth="210"/>
                                        <TextField fx:id="exerciseTitleField" promptText="%teaching-content.43" prefWidth="250"/>
                                        <TextField fx:id="datasetVersionField" promptText="%teaching-content.44" prefWidth="170"/>
                                        <TextField fx:id="evaluationRuleField" promptText="%teaching-content.45" prefWidth="210"/>
                                    </FlowPane>
                                    <TextArea fx:id="exercisePromptField" promptText="%teaching-content.46" prefRowCount="3" wrapText="true"/>
                                    <HBox spacing="10" alignment="CENTER_RIGHT">
                                        <Button text="%teaching-content.47" onAction="#onToggleExerciseStatus" styleClass="secondary-button"/>
                                        <Button text="%teaching-content.48" onAction="#onPublishExercise" styleClass="primary-button"/>
                                    </HBox>
                                    <ListView fx:id="exerciseList" prefHeight="126"/>
                                </VBox>

                                <VBox spacing="10" styleClass="panel-card">
                                    <Label text="%teaching-content.49" styleClass="section-title"/>
                                    <FlowPane hgap="10" vgap="10">
                                        <ComboBox fx:id="assignmentClassroomCombo" prefWidth="240"/>
                                        <TextField fx:id="assignmentTitleField" promptText="%teaching-content.50" prefWidth="250"/>
                                        <DatePicker fx:id="assignmentDueDatePicker" promptText="%teaching-content.51" prefWidth="170"/>
                                        <ComboBox fx:id="assignmentDueTimeCombo" promptText="%teaching-content.52" prefWidth="110"/>
                                        <Button text="%teaching-content.53" onAction="#onCreateAssignmentSnapshot" styleClass="primary-button"/>
                                    </FlowPane>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </Tab>

                <Tab text="%teaching-content.54">
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
                        <content>
                            <VBox spacing="14" styleClass="page-content">
                                <padding><Insets top="18" right="22" bottom="24" left="22"/></padding>
                                <VBox spacing="10" styleClass="panel-card">
                                    <Label text="%teaching-content.55" styleClass="section-title"/>
                                    <Label text="%teaching-content.56"
                                           wrapText="true" styleClass="page-subtitle"/>
                                    <FlowPane hgap="10" vgap="10">
                                        <ComboBox fx:id="learningClassroomCombo" prefWidth="250"/>
                                        <ComboBox fx:id="learningAssignmentCombo" prefWidth="300"/>
                                        <ComboBox fx:id="learningStudentCombo" prefWidth="220"/>
                                        <Button text="%teaching-content.57" onAction="#onRefreshLearning" styleClass="primary-button"/>
                                    </FlowPane>
                                </VBox>
                                <VBox spacing="10" styleClass="panel-card">
                                    <Label text="%teaching-content.58" styleClass="section-title"/>
                                    <Label text="%teaching-content.59"
                                           wrapText="true" styleClass="page-subtitle"/>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Button text="%teaching-content.60" onAction="#onRefreshObjectiveSummary" styleClass="secondary-button"/>
                                        <Button text="%teaching-content.61" onAction="#onPrepareObjectiveIntervention" styleClass="secondary-button"/>
                                        <Button fx:id="confirmInterventionButton" text="%teaching-content.62" onAction="#onConfirmObjectiveIntervention" styleClass="primary-button"/>
                                    </HBox>
                                    <ListView fx:id="objectiveSummaryList" prefHeight="120"/>
                                    <TextArea fx:id="interventionActionField" promptText="%teaching-content.63" prefRowCount="2" wrapText="true"/>
                                </VBox>
                                <SplitPane dividerPositions="0.46" VBox.vgrow="ALWAYS">
                                    <VBox spacing="8" styleClass="panel-card">
                                        <Label text="%teaching-content.64" styleClass="card-title"/>
                                        <ListView fx:id="masteryList" prefHeight="250" VBox.vgrow="ALWAYS"/>
                                    </VBox>
                                    <VBox spacing="8" styleClass="panel-card">
                                        <Label text="%teaching-content.65" styleClass="card-title"/>
                                        <ListView fx:id="feedbackList" prefHeight="190" VBox.vgrow="ALWAYS"/>
                                    </VBox>
                                </SplitPane>
                                <VBox fx:id="feedbackEditorPane" spacing="10" styleClass="panel-card">
                                    <Label text="%teaching-content.66" styleClass="section-title"/>
                                    <FlowPane hgap="10" vgap="10">
                                        <TextField fx:id="submissionIdField" promptText="%teaching-content.67" prefWidth="300"/>
                                        <ComboBox fx:id="feedbackStatusCombo" prefWidth="180"/>
                                        <ComboBox fx:id="feedbackDraftStyleCombo" prefWidth="150" promptText="%teaching-content.68"/>
                                        <Button text="%teaching-content.69" onAction="#onDraftFeedback" styleClass="secondary-button"/>
                                        <Button text="%teaching-content.70" onAction="#onSaveFeedback" styleClass="primary-button"/>
                                    </FlowPane>
                                    <TextArea fx:id="feedbackCommentField" promptText="%teaching-content.71" prefRowCount="4" wrapText="true"/>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </Tab>

                <Tab text="%teaching-content.72">
                    <VBox spacing="12" styleClass="page-content">
                        <padding><Insets top="18" right="22" bottom="24" left="22"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="%teaching-content.73" styleClass="section-title"/>
                                <Label text="%teaching-content.74" styleClass="page-subtitle"/>
                            </VBox>
                            <Button text="%teaching-content.75" onAction="#onRefreshNotifications" styleClass="secondary-button"/>
                            <Button fx:id="markReadButton" text="%teaching-content.76" onAction="#onMarkNotificationRead" disable="true" styleClass="primary-button"/>
                        </HBox>
                        <VBox spacing="8" styleClass="panel-card" VBox.vgrow="ALWAYS">
                            <Label text="%teaching-content.77" styleClass="card-title"/>
                            <ListView fx:id="notificationList" styleClass="notification-list" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
