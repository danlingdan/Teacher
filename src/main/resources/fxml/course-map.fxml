<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import com.sqlteacher.desktop.component.PageHeader?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.CourseMapController"
            styleClass="course-map-page">
    <top>
        <VBox spacing="8" styleClass="page-heading">
            <padding><Insets top="24" right="28" bottom="18" left="28"/></padding>
            <PageHeader eyebrow="%alpha2.courseMap.eyebrow" title="%alpha2.courseMap.title"
                        description="%alpha2.courseMap.subtitle">
                <actions>
                    <Button text="%alpha2.refresh" onAction="#refresh" styleClass="secondary-button"/>
                </actions>
            </PageHeader>
            <Label fx:id="summaryLabel" text="%state.loading" styleClass="course-map-summary"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox fx:id="courseList" spacing="16">
                    <padding><Insets top="8" right="28" bottom="28" left="28"/></padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <Label fx:id="stateLabel" text="%alpha2.courseMap.loading" styleClass="workspace-status">
            <BorderPane.margin><Insets top="10" right="28" bottom="16" left="28"/></BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
