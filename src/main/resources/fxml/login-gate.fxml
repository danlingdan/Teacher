<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.sqlteacher.desktop.controller.LoginGateController"
           styleClass="login-gate">
    <children>
        <Region styleClass="login-glow, login-glow-one"/>
        <Region styleClass="login-glow, login-glow-two"/>
        <HBox alignment="CENTER" spacing="54" maxWidth="1040" styleClass="login-layout">
            <children>
                <VBox spacing="20" prefWidth="440" maxWidth="440" styleClass="login-brand-panel">
                    <children>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <children>
                                <Region styleClass="login-logo"/>
                                <Label text="SQL Teacher" styleClass="login-brand-name"/>
                            </children>
                        </HBox>
                        <Label text="%login-gate.1" wrapText="true" styleClass="login-hero-title"/>
                        <Label text="%login-gate.2" wrapText="true" styleClass="login-hero-copy"/>
                        <VBox spacing="12" styleClass="login-feature-list">
                            <children>
                                <Label text="%login-gate.3" styleClass="login-feature"/>
                                <Label text="%login-gate.4" styleClass="login-feature"/>
                                <Label text="%login-gate.5" styleClass="login-feature"/>
                            </children>
                        </VBox>
                        <Label text="%login-gate.6" wrapText="true" styleClass="login-guest-note"/>
                    </children>
                </VBox>

                <VBox spacing="14" prefWidth="390" maxWidth="390" styleClass="login-card">
                    <children>
                        <Label text="%login-gate.7" styleClass="login-card-title"/>
                        <Label text="%login-gate.8" styleClass="login-card-subtitle"/>
                        <HBox fx:id="statusBox" spacing="8" alignment="CENTER_LEFT" styleClass="login-status, login-status-info">
                            <children>
                                <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false" prefWidth="18" prefHeight="18"/>
                                <Label fx:id="statusLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>
                        <VBox spacing="7">
                            <children>
                                <Label text="%login-gate.9" styleClass="login-field-label"/>
                                <TextField fx:id="emailField" promptText="name@example.com"/>
                            </children>
                        </VBox>
                        <VBox spacing="7">
                            <children>
                                <Label text="%login-gate.10" styleClass="login-field-label"/>
                                <TextField fx:id="displayNameField" promptText="%login-gate.11"/>
                            </children>
                        </VBox>
                        <VBox spacing="7">
                            <children>
                                <Label text="%login-gate.12" styleClass="login-field-label"/>
                                <PasswordField fx:id="passwordField" promptText="%login-gate.13"/>
                            </children>
                        </VBox>
                        <Button fx:id="loginButton" text="%login-gate.14" onAction="#onLogin" defaultButton="true" maxWidth="Infinity" styleClass="login-primary-button"/>
                        <Button fx:id="registerButton" text="%login-gate.15" onAction="#onRegister" maxWidth="Infinity" styleClass="login-secondary-button"/>
                        <HBox alignment="CENTER" spacing="10">
                            <children>
                                <Separator HBox.hgrow="ALWAYS"/>
                                <Label text="%login-gate.16" styleClass="login-or-label"/>
                                <Separator HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>
                        <Button fx:id="guestButton" text="%login-gate.17" onAction="#onGuest" maxWidth="Infinity" styleClass="login-guest-button"/>
                        <Label text="%login-gate.18" wrapText="true" styleClass="login-policy-note"/>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets top="42" right="42" bottom="42" left="42"/>
    </padding>
</StackPane>
