<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sqlteacher.desktop.controller.DataMaintenanceController"
            fitToWidth="true" styleClass="connection-form-scroll">
    <VBox spacing="16" styleClass="panel-card">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
        <Label text="%data-maintenance.1" styleClass="card-title"/>
        <GridPane hgap="14" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="110" halignment="RIGHT"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="%data-maintenance.2" styleClass="form-label"/>
            <Label fx:id="versionLabel" GridPane.columnIndex="1" wrapText="true"/>
            <Label text="%data-maintenance.3" GridPane.rowIndex="1" styleClass="form-label"/>
            <Label fx:id="dataDirectoryLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" wrapText="true"/>
            <Label text="%data-maintenance.4" GridPane.rowIndex="2" styleClass="form-label"/>
            <Label text="%data-maintenance.5" GridPane.columnIndex="1" GridPane.rowIndex="2" wrapText="true"/>
        </GridPane>
        <Separator/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="%data-maintenance.6" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="refreshBackupsButton" text="%data-maintenance.7" onAction="#onRefreshBackups" styleClass="refresh-button"/>
            <Button fx:id="createBackupButton" text="%data-maintenance.8" onAction="#onCreateBackup" styleClass="sql-execute-button"/>
        </HBox>
        <Label text="%data-maintenance.9" wrapText="true" styleClass="page-subtitle"/>
        <ListView fx:id="backupList" prefHeight="240" VBox.vgrow="ALWAYS" styleClass="connection-list"/>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="restoreDemoButton" text="%data-maintenance.10" onAction="#onRestoreDemo" styleClass="refresh-button"/>
            <Button fx:id="restoreBackupButton" text="%data-maintenance.11" onAction="#onRestoreBackup" styleClass="danger-button"/>
        </HBox>
        <Label fx:id="maintenanceStatusLabel" text="%data-maintenance.12" wrapText="true" styleClass="sql-result-hint"/>
    </VBox>
</ScrollPane>
